+
+it("invalidates one-use batch metadata across owners and nested rollback", async () => {
+  await runInDurableObject(env.VFS_TEST.getByName("stat-batch-shared"), async (_, state) => {
+    await state.storage.deleteAll();
+    const first = new TransactionalFileSystem(state.storage);
+    const second = new DurableObjectFileSystem(state.storage);
+    await first.writeFile("/file", "body");
+    await first.writeFile("/other", "other");
+    const user = first.forCredentials({ uid: 1000, gid: 1000 });
+    const warm = () => user.statMany?.(["/file", "/other"]);
+    warm();
+    second.setMetadata("/file", { mode: 0o100600 });
+    expect(() => user.readFile("/file", { range: { offset: 0 } })).toThrow(
+      expect.objectContaining({ code: "EACCES" }),
+    );
+    second.setMetadata("/file", { mode: 0o100644 });
+    warm();
+    expect(() =>
+      first.transact(() => {
+        second.setMetadata("/file", { mode: 0o100000 });
+        warm();
+        expect(() => user.readFile("/file", { range: { offset: 0 } })).toThrow(
+          expect.objectContaining({ code: "EACCES" }),
+        );
+        throw new Error("rollback batch metadata");
+      }),
+    ).toThrow("rollback batch metadata");
+    expect(await new Response(user.readFile("/file", { range: { offset: 0 } }).stream).text()).toBe(
+      "body",
+    );
+    warm();
+    await second.writeFile("/file", "new body");
+    expect(await new Response(user.readFile("/file", { range: { offset: 0 } }).stream).text()).toBe(
+      "new body",
+    );
+  });
+});
diff --git a/test/vfs-stat-batch-reuse.test.ts b/test/vfs-stat-batch-reuse.test.ts
new file mode 100644
index 0000000..c2c1a2a
--- /dev/null
+++ b/test/vfs-stat-batch-reuse.test.ts
@@ -0,0 +1,190 @@
+import { expect, it } from "vitest";
+import { NodeSqlFileSystem } from "../src/testing/node.js";
+import { createTestFileSystem } from "./helpers/node-sql.js";
+
+it("reuses one batch projection without granting the stat caller permission to read", async () => {
+  let statements = 0;
+  let returnedRows = 0;
+  const fs = createTestFileSystem({
+    onStatement: (_query, rows) => {
+      statements++;
+      returnedRows += rows;
+    },
+  });
+  await fs.writeFile("/private", "secret", { mode: 0o100600 });
+  await fs.writeFile("/public", "body");
+  const user = fs.forCredentials({ uid: 1000, gid: 1000 });
+  user.statMany?.(["/private", "/public"]);
+  expect(() => user.readFile("/private", { range: { offset: 0 } })).toThrow(
+    expect.objectContaining({ code: "EACCES" }),
+  );
+  statements = 0;
+  returnedRows = 0;
+  await user.readFile("/public", { range: { offset: Number.MAX_SAFE_INTEGER } }).stream.cancel();
+  expect(statements).toBe(1);
+  expect(returnedRows).toBe(0);
+  // A snapshot is consumed, not retained indefinitely.
+  await user.readFile("/public", { range: { offset: Number.MAX_SAFE_INTEGER } }).stream.cancel();
+  expect(statements).toBe(2);
+  expect(returnedRows).toBe(1);
+});
+
+it("discards batch snapshots after replacement, deletion, ownership and directory permission changes", async () => {
+  const fs = createTestFileSystem();
+  await fs.writeFile("/a/file", "old", { createParents: true });
+  await fs.writeFile("/other", "other");
+  const user = fs.forCredentials({ uid: 1000, gid: 1000 });
+  const warm = () => user.statMany?.(["/a/file", "/other"]);
+  warm();
+  await fs.writeFile("/a/file", "new and longer");
+  expect(await new Response(user.readFile("/a/file", { range: { offset: 0 } }).stream).text()).toBe(
+    "new and longer",
+  );
+  warm();
+  fs.setMetadata("/a/file", { mode: 0o100600 });
+  expect(() => user.readFile("/a/file", { range: { offset: 0 } })).toThrow(
+    expect.objectContaining({ code: "EACCES" }),
+  );
+  warm();
+  fs.setOwnership("/a/file", { uid: 1000, gid: 1000 });
+  await user.readFile("/a/file", { range: { offset: 0 } }).stream.cancel();
+  warm();
+  fs.setMetadata("/a", { mode: 0o40000 });
+  expect(() => user.readFile("/a/file", { range: { offset: 0 } })).toThrow(
+    expect.objectContaining({ code: "EACCES" }),
+  );
+  fs.setMetadata("/a", { mode: 0o40755 });
+  warm();
+  await fs.remove("/a/file");
+  expect(() => user.readFile("/a/file", { range: { offset: 0 } })).toThrow(
+    expect.objectContaining({ code: "ENOENT" }),
+  );
+  await fs.writeFile("/replacement", "replacement");
+  await fs.writeFile("/a/file", "old");
+  warm();
+  await fs.move("/replacement", "/a/file", { replace: true });
+  expect(await new Response(user.readFile("/a/file", { range: { offset: 0 } }).stream).text()).toBe(
+    "replacement",
+  );
+});
+
+it("preserves ranged snapshots for both single-chunk and multi-chunk batched files", async () => {
+  const fs = createTestFileSystem({ chunkBytes: 4 });
+  await fs.writeFile("/small", "one");
+  await fs.writeFile("/large", "several chunks of content");
+  fs.statMany(["/small", "/large"]);
+  const small = fs.readFile("/small", { range: { offset: 0 } });
+  const large = fs.readFile("/large", { range: { offset: 0 } });
+  await fs.writeFile("/small", "replacement");
+  await fs.writeFile("/large", "new");
+  expect(await new Response(small.stream).text()).toBe("one");
+  expect(await new Response(large.stream).text()).toBe("several chunks of content");
+  expect(small.stat.sizeBytes).toBe(3);
+  expect(large.stat.sizeBytes).toBe(25);
+  expect(await new Response(fs.readFile("/small", { range: { offset: 0 } }).stream).text()).toBe(
+    "replacement",
+  );
+  expect(await new Response(fs.readFile("/large", { range: { offset: 0 } }).stream).text()).toBe(
+    "new",
+  );
+});
+
+it("keeps path-resolution errors and symlink permissions after a batch lookup", async () => {
+  const fs = createTestFileSystem();
+  await fs.writeFile("/public", "public");
+  await fs.writeFile("/private", "secret", { mode: 0o100600 });
+  const user = fs.forCredentials({ uid: 1000, gid: 1000 });
+  user.statMany?.(["/public", "/private"]);
+  for (const reader of [fs, user]) {
+    expect(() => reader.readFile("/public/", { range: { offset: 0 } })).toThrow(
+      expect.objectContaining({ code: "ENOTDIR" }),
+    );
+    expect(() => reader.readFile("/public/../private", { range: { offset: 0 } })).toThrow(
+      expect.objectContaining({ code: "ENOTDIR" }),
+    );
+    expect(() => reader.readFile("/missing/../public", { range: { offset: 0 } })).toThrow(
+      expect.objectContaining({ code: "ENOENT" }),
+    );
+  }
+  await fs.move("/public", "/moved");
+  fs.symlink("/public", "/private");
+  expect(() => user.readFile("/public", { range: { offset: 0 } })).toThrow(
+    expect.objectContaining({ code: "EACCES" }),
+  );
+  expect(await new Response(fs.readFile("/public", { range: { offset: 0 } }).stream).text()).toBe(
+    "secret",
+  );
+});
+
+it("discards metadata prefetched by a transaction-begin observer before changing permissions", async () => {
+  let prefetchOnBegin = false;
+  const fs = createTestFileSystem({
+    onStatement(query) {
+      if (prefetchOnBegin && query === "BEGIN") {
+        prefetchOnBegin = false;
+        fs.statMany(["/public", "/other"]);
+      }
+    },
+  });
+  await fs.writeFile("/public", "body");
+  await fs.writeFile("/other", "other");
+  const user = fs.forCredentials({ uid: 1000, gid: 1000 });
+  prefetchOnBegin = true;
+  fs.setMetadata("/public", { mode: 0o100600 });
+  expect(() => user.readFile("/public", { range: { offset: 0 } })).toThrow(
+    expect.objectContaining({ code: "EACCES" }),
+  );
+});
+
+it("does not retain batch metadata when a query observer changes permissions", async () => {
+  let changeOnBatch = false;
+  const fs = createTestFileSystem({
+    onStatement(query) {
+      if (changeOnBatch && query.includes("FROM requested CROSS JOIN")) {
+        changeOnBatch = false;
+        fs.setMetadata("/public", { mode: 0o100600 });
+      }
+    },
+  });
+  await fs.writeFile("/public", "body");
+  await fs.writeFile("/other", "other");
+  const user = fs.forCredentials({ uid: 1000, gid: 1000 });
+  changeOnBatch = true;
+  user.statMany?.(["/public", "/other"]);
+  expect(() => user.readFile("/public", { range: { offset: Number.MAX_SAFE_INTEGER } })).toThrow(
+    expect.objectContaining({ code: "EACCES" }),
+  );
+});
+
+it("discards metadata prefetched after a callback when committing the transaction fails", async () => {
+  class CommitObserverFileSystem extends NodeSqlFileSystem {
+    beforeCommit: (() => void) | undefined;
+    constructor() {
+      super();
+      const transact = this.storage.transactionSync.bind(this.storage);
+      this.storage.transactionSync = (callback) =>
+        transact(() => {
+          const result = callback();
+          this.beforeCommit?.();
+          return result;
+        });
+    }
+  }
+  const fs = new CommitObserverFileSystem();
+  try {
+    await fs.writeFile("/public", "body");
+    await fs.writeFile("/other", "other");
+    const user = fs.forCredentials({ uid: 1000, gid: 1000 });
+    fs.beforeCommit = () => {
+      fs.beforeCommit = undefined;
+      user.statMany?.(["/public", "/other"]);
+      throw new Error("injected commit failure");
+    };
+    expect(() => fs.setMetadata("/public", { mode: 0o100600 })).toThrow("injected commit failure");
+    expect(
+      await new Response(user.readFile("/public", { range: { offset: 0 } }).stream).text(),
+    ).toBe("body");
+  } finally {
+    fs.close();
+  }
+});
diff --git a/test/vfs-storage-lifetime.test.ts b/test/vfs-storage-lifetime.test.ts
