+  private readSmallEntry(path: string): { entry: EntryRow; body?: ArrayBuffer } | undefined {
+    const row = firstRow(this.sql.exec<SqlRow>(
+      `SELECT ${ENTRY_COLUMNS},
+         CASE WHEN e.content_class = 'inline' AND e.size_bytes BETWEEN 1 AND 16384
+           THEN (SELECT body FROM vfs_inline_chunks WHERE entry_id = e.id AND chunk_index = 0)
+           ELSE NULL END AS body
+       FROM vfs_entries e INDEXED BY vfs_entries_path WHERE e.path = ?`, path,
+    ));
+    if (row === undefined) return undefined;
+    const entry = parseEntry(row, this.mutationEpoch);
+    const body = row["body"];
+    return body instanceof ArrayBuffer && body.byteLength === entry.sizeBytes
+      ? { entry, body } : { entry };
+  }
