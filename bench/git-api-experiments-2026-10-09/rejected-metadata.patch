+import { expect, it } from "vitest";
+import { statMany } from "../src/vfs/metadata.js";
+import { createTestFileSystem } from "./helpers/node-sql.js";
+
+it("returns an ordered fresh metadata snapshot with duplicate paths", async () => {
+  let statements = 0;
+  const vfs = createTestFileSystem({ onStatement: () => statements++ });
+  vfs.mkdir("/repo");
+  await vfs.writeFile("/repo/a", "a");
+  await vfs.writeFile("/repo/b", "bb");
+  const paths = ["/repo/b", "/repo/a", "/repo/b"];
+  const expected = paths.map((path) => vfs.stat(path));
+  statements = 0;
+  const snapshot = vfs.statMany(paths);
+  expect(snapshot).toEqual(expected);
+  expect(statements).toBe(1);
+  await vfs.writeFile("/repo/a", "changed");
+  expect(vfs.statMany(["/repo/a"])[0]?.revision).toBeGreaterThan(snapshot[1]?.revision ?? 0);
+  expect(snapshot[1]?.sizeBytes).toBe(1);
+});
+
+it("accepts empty batches and refuses batches beyond the metadata bound", () => {
+  const vfs = createTestFileSystem();
+  expect(vfs.statMany([])).toEqual([]);
+  expect(() => vfs.statMany(Array.from({ length: 1025 }, () => "/"))).toThrow(/1024/);
+});
+
+it("uses the same symlink, dot-component and trailing-slash semantics as stat and lstat", async () => {
+  const vfs = createTestFileSystem();
+  vfs.mkdir("/repo/d", true);
+  await vfs.writeFile("/repo/a", "a");
+  vfs.symlink("/repo/link", "a");
+  vfs.symlink("/alias", "/repo");
+  const paths = ["/repo/link", "/alias/a", "/repo/d/../a", "/repo/d/", "repo/a"];
+  expect(vfs.statMany(paths)).toEqual(paths.map((path) => vfs.stat(path)));
+  expect(vfs.statMany(paths, { follow: false })).toEqual(paths.map((path) => vfs.lstat(path)));
+  expect(() => vfs.statMany(["/repo/link/"], { follow: false })).toThrow(/directory/);
+});
+
+it("checks search permission through a credential-bound metadata batch", async () => {
+  const vfs = createTestFileSystem();
+  vfs.mkdir("/private", false, 0o700);
+  await vfs.writeFile("/private/a", "a");
+  const user = vfs.forCredentials({ uid: 1000, gid: 1000 });
+  expect(() => statMany(user, ["/private/a"])).toThrow(/permission/i);
+  expect(() => user.lstat("/private/a")).toThrow(/permission/i);
+  expect(statMany(user, ["/"])).toEqual([user.stat("/")]);
+});
+
+it("refuses missing paths rather than silently shortening a batch", async () => {
+  const vfs = createTestFileSystem();
+  await vfs.writeFile("/present", "yes");
+  expect(() => vfs.statMany(["/present", "/missing", "/present"])).toThrow(/no such/);
+  expect(vfs.statMany(["/present"])).toEqual([vfs.stat("/present")]);
+});
