@@ -0,0 +1,20 @@
+import { VfsError } from "../core/errors.js";
+import type { VfsStat, VirtualFileSystem } from "./types.js";
+
+interface MetadataBatchFileSystem extends VirtualFileSystem {
+  statMany(paths: readonly string[], options?: { follow?: boolean }): VfsStat[];
+}
+function hasMetadataBatch(fs: VirtualFileSystem): fs is MetadataBatchFileSystem {
+  return "statMany" in fs && typeof fs.statMany === "function";
+}
+/** A bounded metadata snapshot; adapters without batching use ordinary stat/lstat. */
+export function statMany(
+  fs: VirtualFileSystem,
+  paths: readonly string[],
+  options: { follow?: boolean } = {},
+): VfsStat[] {
+  if (paths.length > 1024) throw new VfsError("E2BIG", "metadata batch exceeds 1024 paths");
+  return hasMetadataBatch(fs)
+    ? fs.statMany(paths, options)
+    : paths.map((path) => (options.follow === false ? fs.lstat(path) : fs.stat(path)));
+}
