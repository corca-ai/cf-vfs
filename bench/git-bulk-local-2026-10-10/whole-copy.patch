+async function copyFreshObjects(source: GitRepository, target: GitRepository): Promise<boolean> {
+  const fs = source.fs;
+  const from = `${source.gitdir}/objects`,
+    to = `${target.gitdir}/objects`;
+  const pending = [from];
+  let bytes = 0,
+    largest = 0;
+  while (pending.length > 0) {
+    const directory = pending.pop();
+    if (directory === undefined) break;
+    for (const entry of fs.listEntries(directory)) {
+      fs.check();
+      const expected =
+        (entry.kind === "directory" ? 0o40777 : 0o100666) & ~fs.context.session.umask;
+      if (
+        entry.mode !== expected ||
+        entry.uid !== 0 ||
+        entry.gid !== 0 ||
+        (entry.kind !== "directory" &&
+          (entry.kind !== "file" || entry.contentClass !== "inline" || (entry.nlink ?? 1) !== 1))
+      )
+        return false;
+      if (entry.kind === "directory") pending.push(entry.path);
+      else {
+        bytes += entry.sizeBytes;
+        largest = Math.max(largest, entry.sizeBytes);
+      }
+    }
+  }
+  fs.context.budget.io(bytes * 2);
+  const release = fs.context.budget.buffered(largest);
+  release();
+  for (const entry of fs.listEntries(to)) {
+    if (entry.kind !== "directory" || fs.listEntries(entry.path).length !== 0) return false;
+    await fs.context.fileSystem.remove(entry.path);
+  }
+  await fs.context.fileSystem.copy(from, to, { recursive: true, replace: true });
+  return true;
