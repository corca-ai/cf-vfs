+  private inlineTail(entryId: number): InlineTail {
+    const row = firstRow(
+      this.sql.exec<SqlRow>(
+        `SELECT chunk_index, body FROM vfs_inline_chunks
+       WHERE entry_id = ? ORDER BY chunk_index DESC LIMIT 1`,
+        entryId,
+      ),
+    );
+    return row === undefined
+      ? null
+      : {
+          index: integerColumn(row, "chunk_index"),
+          body: new Uint8Array(blobColumn(row, "body")),
+        };
+  }
+
+  private directAppend(path: string) {
+    // A materialized string cannot yield between this snapshot and commit.
+    // The unique pathname lookup and descending chunk primary key seek one
+    // tail, even for large files; no cursor crosses an await.
+    const normalized = normalizePath(path);
+    const row = firstRow(
+      this.sql.exec<SqlRow>(
+        `SELECT ${ENTRY_COLUMNS}, c.chunk_index AS last_chunk_index, c.body AS last_body
+       FROM vfs_entries e INDEXED BY vfs_entries_path
+       LEFT JOIN vfs_inline_chunks c ON c.entry_id = e.id AND e.content_class = 'inline'
+       WHERE e.path = ? ORDER BY c.chunk_index DESC LIMIT 1`,
+        normalized,
+      ),
+    );
+    if (row === undefined) throw new VfsError("ENOENT", "no such file or directory", normalized);
+    return {
+      access: { path: normalized, row: parseEntry(row, this.mutationEpoch), followed: [] },
+      tail:
+        row["last_chunk_index"] === null
+          ? null
+          : {
+              index: integerColumn(row, "last_chunk_index"),
+              body: new Uint8Array(blobColumn(row, "last_body")),
+            },
+    };
+  }
