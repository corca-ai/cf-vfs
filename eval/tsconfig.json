{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ]
  },
  "include": ["./**/*.ts"],
  // The deployment config resolves `cf/config` from this package's own
  // dependencies, which the repository-wide checks do not install. The
  // replay runs on Node, so the root project checks it.
  "exclude": [
    "node_modules",
    ".cloudflare",
    "cloudflare.config.ts",
    "sql-lab/cloudflare.config.ts",
    "sql-lab/.cloudflare",
    "sql-lab/node_modules",
    "benchmark-deploy",
    "replay.ts"
  ]
}
