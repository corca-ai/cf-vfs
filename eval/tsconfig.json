{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ]
  },
  "include": ["./**/*.ts"],
  // The deployment config resolves `cf/config` from this package's own
  // dependencies, which the repository-wide checks do not install.
  "exclude": ["node_modules", ".cloudflare", "cloudflare.config.ts", "benchmark-deploy"]
}
