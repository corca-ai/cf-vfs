{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cf-vfs-benchmark",
  "main": "bench/remote-worker.ts",
  "account_id": "b23e9b2e3a9159dd7eb3fa51f839c5c5",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "version_metadata": { "binding": "VERSION_METADATA" },
  "routes": [
    {
      "pattern": "vfs.borca.ai",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["BENCHMARK_TOKEN", "PUBLIC_BENCHMARK_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./demo/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [{ "binding": "BENCHMARK_RUNNER", "service": "cf-vfs-benchmark", "entrypoint": "BenchmarkRunner" }],
  "r2_buckets": [
    {
      "binding": "BENCHMARK_BUCKET",
      "bucket_name": "cf-vfs-benchmark"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PUBLIC_BENCHMARKS", "class_name": "PublicBenchmarks" },
      {
        "name": "BENCHMARK",
        "class_name": "VfsBenchmark"
      },
      {
        "name": "DEMO_WORKSPACES",
        "class_name": "DemoWorkspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VfsBenchmark"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["DemoWorkspace"]
    },
    { "tag": "v3", "new_sqlite_classes": ["PublicBenchmarks"] }
  ]
}
