{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The published surface is the exports map: anything reachable from a
  // subpath is public API, not dead code. Everything else — tests, benchmarks,
  // scripts, tree-shaking fixtures, and Wrangler entry points — is a root of
  // its own, so knip reports only genuinely unreachable code.
  "entry": [
    "src/index.ts",
    "src/core/index.ts",
    "src/vfs/index.ts",
    "src/fs/index.ts",
    "src/fs/metadata.ts",
    "src/fs/content.ts",
    "src/collab/index.ts",
    "src/shell/index.ts",
    "src/shell/interactive.ts",
    "src/shell/linux.ts",
    "src/shell/commands/index.ts",
    "src/shell/commands/applet.ts",
    "src/shell/commands/default.ts",
    "src/shell/commands/core.ts",
    "src/shell/commands/discovery.ts",
    "src/shell/commands/fs.ts",
    "src/shell/commands/ls.ts",
    "src/shell/commands/help.ts",
    "src/shell/completion.ts",
    "src/shell/content.ts",
    "src/shell/opaque.ts",
    "src/shell/commands/link.ts",
    "src/shell/commands/sed.ts",
    "src/shell/commands/system.ts",
    "src/shell/commands/sh.ts",
    "src/shell/commands/git.ts",
    "src/shell/commands/git-tracked.ts",
    "src/shell/commands/text.ts",
    "src/shell/commands/xargs.ts",
    "src/storage/do-sql.ts",
    "src/storage/r2.ts",
    "src/durable-object.ts",
    "src/testing/index.ts",
    "src/testing/node.ts",
    "test/**/*.test.ts",
    "test/worker.ts",
    "test/repl-worker.ts",
    "test/check-*.mjs",
    "test/fixtures/*-worker.ts",
    "bench/*.bench.ts",
    "bench/*.mjs",
    "bench/remote-worker.ts",
    "bench/agent-task-2026-10-12/worker.ts",
    "bench/coding-durability-2026-10-10/worker.ts",
    "bench/git-no-api-2026-10-10/worker.ts",
    "bench/posix-api-2026-10-10/worker.ts",
    "bench/three-hour-2026-10-10/worker.ts",
    "bench/five-hour-2026-10-10/worker.ts",
    "bench/capabilities-2026-10-11/worker.ts",
    "bench/capabilities-2026-10-11/full-worker.ts",
    "bench/bash-2026-10-11/worker.ts",
    "bench/agent-shell-2026-10-11/worker.ts",
    "bench/agent-shell-round2-2026-10-11/worker.ts",
    "bench/agent-shell-structural-2026-10-11/worker.ts",
    "bench/workspace-flow-2026-10-12/worker.ts",
    "bench/workspace-flow-2026-10-12/commit-worker.ts",
    "bench/workspace-flow-2026-10-12/final-worker.ts",
    "scripts/*.mjs",
    "eval/worker.ts",
    "eval/test/*.test.ts",
    "vitest*.config.ts"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts", "eval/**/*.ts", "scripts/**/*.mjs"],
  // `cloudflare:workers` and `cloudflare:test` are workerd built-in modules
  // with no package behind them.
  "ignoreDependencies": ["cloudflare"],
  // A separate package with its own dependencies, deployed with `cf`.
  "ignore": ["eval/cloudflare.config.ts", "eval/benchmark-deploy/**"],
  "rules": {
    // A library legitimately exports types consumers never import in this repo.
    "types": "warn",
    "enumMembers": "warn"
  }
}
