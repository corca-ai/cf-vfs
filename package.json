{
  "name": "@corca-ai/cf-vfs",
  "version": "0.1.0",
  "description": "A tree-shakable virtual filesystem for Cloudflare Durable Objects and R2",
  "license": "MIT",
  "author": "corca-ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corca-ai/cf-vfs.git"
  },
  "bugs": {
    "url": "https://github.com/corca-ai/cf-vfs/issues"
  },
  "homepage": "https://github.com/corca-ai/cf-vfs#readme",
  "keywords": [
    "cloudflare",
    "durable-objects",
    "r2",
    "sqlite",
    "virtual-filesystem"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./vfs": {
      "types": "./dist/vfs/index.d.ts",
      "import": "./dist/vfs/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./shell/linux": {
      "types": "./dist/shell/linux.d.ts",
      "import": "./dist/shell/linux.js"
    },
    "./shell/interactive": {
      "types": "./dist/shell/interactive.d.ts",
      "import": "./dist/shell/interactive.js"
    },
    "./shell/commands": {
      "types": "./dist/shell/commands/index.d.ts",
      "import": "./dist/shell/commands/index.js"
    },
    "./shell/commands/applet": {
      "types": "./dist/shell/commands/applet.d.ts",
      "import": "./dist/shell/commands/applet.js"
    },
    "./shell/commands/default": {
      "types": "./dist/shell/commands/default.d.ts",
      "import": "./dist/shell/commands/default.js"
    },
    "./shell/commands/discovery": {
      "types": "./dist/shell/commands/discovery.d.ts",
      "import": "./dist/shell/commands/discovery.js"
    },
    "./shell/commands/core": {
      "types": "./dist/shell/commands/core.d.ts",
      "import": "./dist/shell/commands/core.js"
    },
    "./shell/commands/fs": {
      "types": "./dist/shell/commands/fs.d.ts",
      "import": "./dist/shell/commands/fs.js"
    },
    "./shell/content": {
      "types": "./dist/shell/content.d.ts",
      "import": "./dist/shell/content.js"
    },
    "./shell/opaque": {
      "types": "./dist/shell/opaque.d.ts",
      "import": "./dist/shell/opaque.js"
    },
    "./shell/commands/link": {
      "types": "./dist/shell/commands/link.d.ts",
      "import": "./dist/shell/commands/link.js"
    },
    "./shell/commands/help": {
      "types": "./dist/shell/commands/help.d.ts",
      "import": "./dist/shell/commands/help.js"
    },
    "./shell/commands/sed": {
      "types": "./dist/shell/commands/sed.d.ts",
      "import": "./dist/shell/commands/sed.js"
    },
    "./shell/commands/system": {
      "types": "./dist/shell/commands/system.d.ts",
      "import": "./dist/shell/commands/system.js"
    },
    "./shell/commands/sh": {
      "types": "./dist/shell/commands/sh.d.ts",
      "import": "./dist/shell/commands/sh.js"
    },
    "./shell/commands/ls": {
      "types": "./dist/shell/commands/ls.d.ts",
      "import": "./dist/shell/commands/ls.js"
    },
    "./shell/commands/text": {
      "types": "./dist/shell/commands/text.d.ts",
      "import": "./dist/shell/commands/text.js"
    },
    "./shell/commands/xargs": {
      "types": "./dist/shell/commands/xargs.d.ts",
      "import": "./dist/shell/commands/xargs.js"
    },
    "./storage/do-sql": {
      "types": "./dist/storage/do-sql.d.ts",
      "import": "./dist/storage/do-sql.js"
    },
    "./storage/r2": {
      "types": "./dist/storage/r2.d.ts",
      "import": "./dist/storage/r2.js"
    },
    "./durable-object": {
      "types": "./dist/durable-object.d.ts",
      "import": "./dist/durable-object.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/node": {
      "types": "./dist/testing/node.d.ts",
      "import": "./dist/testing/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "typegen:test": "wrangler types worker-configuration.d.ts --config wrangler.test.jsonc --env-interface VfsTestEnv --include-runtime false",
    "typegen:benchmark": "wrangler types bench/worker-configuration.d.ts --config wrangler.benchmark.jsonc --env-interface VfsBenchmarkEnv --include-runtime false",
    "typegen": "npm run typegen:test && npm run typegen:benchmark",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "knip": "knip",
    "typecheck": "tsc --noEmit && tsc -p bench/tsconfig.remote.json",
    "test": "vitest run --config vitest.node.config.ts && vitest run",
    "test:docs": "node test/check-docs.mjs",
    "test:package": "node test/check-package.mjs",
    "test:tree-shaking": "npm run build && node test/check-tree-shaking.mjs",
    "bench": "npm run build && node bench/benchmarks.mjs",
    "bench:do": "vitest run --config vitest.performance.config.ts --disableConsoleIntercept",
    "bench:all": "npm run bench && npm run bench:do",
    "bench:check": "npm run build && node bench/check-node-sql.mjs && npm run bench:do",
    "bench:remote": "node bench/remote.mjs",
    "bench:remote:check": "node bench/remote.mjs --check bench/remote-baseline-2026-07-24.json",
    "repl": "npm run build && node scripts/repl.mjs",
    "repl:sqlite": "npm run build && node scripts/repl-sqlite.mjs",
    "test:bash-fixtures:regenerate": "node scripts/regenerate-bash-fixtures.mjs",
    "test:utility-fixtures:regenerate": "node scripts/regenerate-utility-fixtures.mjs",
    "test:bundle-budgets:record": "npm run build && node test/check-tree-shaking.mjs --record",
    "check": "npm run typegen && npm run build && npm run typecheck && npm run lint && npm run knip && npm test && npm run test:docs && npm run test:package && npm run test:tree-shaking"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/vitest-pool-workers": "0.18.6",
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/node": "24.13.3",
    "knip": "6.29.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
