  "divergences": [
    {
      "id": "jq-exponent-literals",
      "summary": "a number written with an exponent is re-rendered from its value, where jq re-spells it in its own notation",
      "reason": "An untouched number keeps the spelling it arrived with, which is what makes 1.0, 2.50, and an integer past a double's reach print back unchanged. jq passes an exponent through its own formatter instead \u2014 1e3 becomes 1E+3 while 1e-3 becomes 0.001 \u2014 and reproducing that formatter is a larger commitment than this profile makes. The value is identical; only the spelling differs."
    },
    {
      "id": "jq-bindings-precede-the-filter",
      "summary": "--arg and --argjson must appear before the filter",
      "reason": "Each spends two words while the option parser reports only the name, so the value is read as the operand that follows. jq consumes argv positionally and accepts a binding written after the filter; here that would take the filter as the value. Refusing is a usage error rather than a silent misreading."
    },
    {
      "id": "jq-profile-refuses-the-rest",
      "summary": "def, reduce, foreach, try/catch, label, as bindings, recursive descent, string interpolation, format strings, and the regular-expression builtins are refused",
      "reason": "A declared subset, refused where it is written with status 3 rather than approximated. The regular-expression builtins are excluded on purpose rather than pending: jq matches with Oniguruma and this repository has a POSIX engine, so test(\"a+\") would mean two different things under one name."
    }
  ]
