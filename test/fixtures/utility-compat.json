  "divergences": [
    {
      "id": "cut-list-ranges-unsupported",
      "command": "cut",
      "oracle": "coreutils",
      "summary": "-f and -c accept a comma-separated list of positive integers, not ranges or open-ended selections",
      "reason": "A range needs an ordering and clamping model the streaming record profile does not yet declare. `cut -c2-4` is a usage error with status 2 rather than a silent approximation of GNU behavior."
    },
    {
      "id": "wc-multi-field-padding",
      "command": "wc",
      "oracle": "coreutils",
      "summary": "multi-field wc output is single-space separated instead of right-aligned in width-dependent columns",
      "reason": "GNU pads each count to a width derived from the largest input, which makes output depend on values the streaming profile never buffers. Single-field forms such as `wc -l` match exactly."
    },
    {
      "id": "diff-output-format",
      "command": "diff",
      "oracle": "coreutils",
      "summary": "diff always emits the unified format used by patch, with no context or ed output modes",
      "reason": "GNU diff defaults to the normal format and selects others by option. cf-vfs documents one format so `diff | patch` composes deterministically."
    },
    {
      "id": "regexp-dialect-is-javascript",
      "command": "grep, sed",
      "oracle": "coreutils",
      "summary": "patterns use JavaScript regular-expression syntax under the Unicode flag, not POSIX basic or extended regular expressions",
      "reason": "The runtime compiles a pattern with the Workers RegExp engine rather than shipping a POSIX matcher. Literals, `.`, `*`, `^`, `$`, and bracket expressions agree with BRE and are pinned by fixtures, but every other metacharacter differs: `a+` repeats in cf-vfs and is literal in BRE, while `a\\|x` alternates in BRE and is literal here. `grep -E` and a declared BRE translation are follow-up work in #49."
    },
    {
      "id": "sed-replacement-is-literal-text",
      "command": "sed",
      "oracle": "coreutils",
      "summary": "the replacement is literal text with no match reference",
      "reason": "GNU sed expands `&` to the match and `\\1` to a capture group. This profile writes both literally and escapes JavaScript's `$&`, `$\\`` , `$'`, and `$n` forms so replacement text taken from data can never splice another part of the record into the output. Capture groups and match references are follow-up work in #49."
    },
    {
      "id": "type-does-not-print-a-function-body",
      "command": "type",
      "oracle": "bash",
      "summary": "type reports that a name is a function without printing its definition",
      "reason": "Bash re-renders the parsed function body, which would make `type` output depend on the formatter rather than on the profile. Reporting the classification keeps the output stable and is what a script testing for a function needs."
    },
    {
      "id": "printenv-reads-one-variable-map",
      "command": "printenv, env",
      "oracle": "coreutils",
      "summary": "printenv reports any set variable, not only exported ones",
      "reason": "A cf-vfs shell has one variable map and no separate process environment to hand a child, so `export` records intent rather than moving a value between scopes. `printenv NAME` therefore prints a variable a POSIX shell would keep to itself. Scripts that test for an inherited variable must not rely on the distinction."
    },
    {
      "id": "script-interpreter-profile-is-bounded",
      "command": "script execution",
      "oracle": "bash",
      "summary": "an executable file runs only as the cf-vfs shell profile, whatever its shebang names",
      "reason": "There is no process runtime to hand a file to, so the only interpreter that can exist is this shell. `/bin/sh`, `/bin/bash`, and `/usr/bin/env sh|bash` select it, a file with no shebang gets it, and every other interpreter is refused with status 126 rather than run by something it did not ask for. Interpreter arguments such as `#!/bin/sh -e` are refused for the same reason."
    },
    {
      "id": "script-child-inherits-the-whole-session",
      "command": "script execution",
      "oracle": "bash",
      "summary": "a script sees every variable, function, and shell option of its caller, not only the exported ones",
      "reason": "A Bash script runs in a separate process and inherits only exported variables and no functions. There is no process boundary here and one variable map, so `export` records intent rather than moving a value; a child therefore sees unexported variables, the caller's functions, and options such as `set -e`. The isolation that does hold is outbound: nothing the child defines, and no working-directory change or `exit` it performs, reaches the caller. Do not rely on `export` to keep a value from a script."
    },
    {
      "id": "dollar-dash-reports-only-declared-options",
      "command": "$-",
      "oracle": "bash",
      "summary": "$- lists only the options this profile spells as short flags",
      "reason": "Bash also reports `h`, `B`, `c`, and interactivity flags for behavior that does not exist here — hashing, brace expansion, and a command-string invocation mode. Reporting `e` and `u` in a fixed order makes the value a declaration of what is on rather than an imitation of a flag set the runtime does not have."
    },
    {
      "id": "permission-predicates-have-no-user",
      "command": "test",
      "oracle": "bash",
      "summary": "-r, -w, and -x report whether any class carries the bit, because there is no user to ask about",
      "reason": "A POSIX shell answers these for the effective user, so the same file gives different answers to different accounts and a privileged account can write a read-only file. There is no user, group, or account here and mode bits enforce nothing, so the predicate reports whether the bit is set for any class. It also does not consult the shell's read and write roots: those refuse the operation, and a predicate that reported them would conflate policy with metadata."
    },
    {
      "id": "tilde-is-not-expanded-inside-a-parameter-word",
      "command": "tilde expansion",
      "oracle": "bash",
      "summary": "an unquoted default such as ${X-~/d} keeps the tilde literal",
      "reason": "Tilde expansion runs on the written word, where quote provenance is still available. A default inside a parameter expansion is produced during that expansion, so treating it as a tilde prefix would mean re-scanning generated text as syntax — which is exactly what this runtime refuses to do everywhere else. Quoted `\"${X-~/d}\"` agrees with Bash; the unquoted form differs."
    }
  ],
