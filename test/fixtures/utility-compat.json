  "divergences": [
    {
      "id": "cut-list-ranges-unsupported",
      "command": "cut",
      "oracle": "coreutils",
      "summary": "-f and -c accept a comma-separated list of positive integers, not ranges or open-ended selections",
      "reason": "A range needs an ordering and clamping model the streaming record profile does not yet declare. `cut -c2-4` is a usage error with status 2 rather than a silent approximation of GNU behavior."
    },
    {
      "id": "wc-multi-field-padding",
      "command": "wc",
      "oracle": "coreutils",
      "summary": "multi-field wc output is single-space separated instead of right-aligned in width-dependent columns",
      "reason": "GNU pads each count to a width derived from the largest input, which makes output depend on values the streaming profile never buffers. Single-field forms such as `wc -l` match exactly."
    },
    {
      "id": "diff-output-format",
      "command": "diff",
      "oracle": "coreutils",
      "summary": "diff always emits the unified format used by patch, with no context or ed output modes",
      "reason": "GNU diff defaults to the normal format and selects others by option. cf-vfs documents one format so `diff | patch` composes deterministically."
    }
  ],
